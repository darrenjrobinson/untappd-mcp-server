{
  "name": "untappd-mcp-server",
  "version": "2.1.0",
  "mcpName": "io.github.darrenjrobinson/untappd",
  "description": "MCP server exposing Untappd API tools for AI agents — full v4 read API coverage",
  "main": "dist/index.js",
  "bin": {
    "untappd-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "auth": "npm run build && node dist/index.js auth"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "untappd",
    "mcp",
    "model-context-protocol",
    "ai",
    "ai-tools",
    "beer",
    "brewery",
    "venue"
  ],
  "author": {
    "name": "Darren Robinson",
    "url": "https://www.npmjs.com/~darrenjrobinson"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darrenjrobinson/untappd-mcp-server.git"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
